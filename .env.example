# Existing public Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Link copied by KO / TW / RU players for the promotional-site event.
# Defaults to the V2 registration link when omitted.
VITE_V2_PROMOTION_URL=https://www.facebook.com/share/p/1EsoFCFXef/

# Paddle.js uses a CLIENT-SIDE token, never your Paddle API key.
# Sandbox tokens start with test_. Live tokens start with live_.
VITE_PADDLE_CLIENT_TOKEN=test_replace_me
VITE_PADDLE_ENV=sandbox

# PayPal JavaScript SDK client IDs. If V1/V2 use the same PayPal Business
# account, configure only VITE_PAYPAL_CLIENT_ID. Per-server values override it.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_CLIENT_ID_V1=
VITE_PAYPAL_CLIENT_ID_V2=

# Server-only Supabase Edge Function secrets (never expose these in Vercel):
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_CLIENT_ID_V1=
# PAYPAL_CLIENT_SECRET_V1=
# PAYPAL_CLIENT_ID_V2=
# PAYPAL_CLIENT_SECRET_V2=
# PAYPAL_ENV=live
#
# Discord can also be split by server. Per-server webhooks override the legacy
# shared webhook when configured.
# DISCORD_DONATION_WEBHOOK_URL=
# DISCORD_DONATION_WEBHOOK_URL_V1=
# DISCORD_DONATION_WEBHOOK_URL_V2=
