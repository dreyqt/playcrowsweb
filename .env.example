# Existing public Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Paddle.js uses a CLIENT-SIDE token, never your Paddle API key.
# Sandbox tokens start with test_. Live tokens start with live_.
VITE_PADDLE_CLIENT_TOKEN=test_replace_me
VITE_PADDLE_ENV=sandbox

# PayPal JavaScript SDK client ID for the Business account (public client ID only).
VITE_PAYPAL_CLIENT_ID=

# Server-only PayPal credentials belong in Supabase Edge Function secrets, NOT Vercel frontend variables:
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=live
